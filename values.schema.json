{
  "title": "Values",
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "if": {
    "properties": {
      "cloud": {
        "enum": ["aws"]
      }
    }
  },
  "then": {
    "required": [
      "sbc" 
    ]
  },
  "else": {
    "required": []
  },
  "properties": {
    "api": {
      "type": "object",
      "properties": {
        "allowPrivateCustomUrls": {
          "description": "TEST-ONLY: renders api-server's ALLOW_PRIVATE_CUSTOM_URLS SSRF escape hatch. Must never be enabled on production values. null (default) follows vgTestHarness.enabled; explicit true/false overrides.",
          "type": ["boolean", "null"]
        }
      }
    },
    "agenticEndpoint": {
      "description": "Fallback for feature-server's dial-time agent routing only, used for an agent-targeted application that predates vg-api-server's per-application agentic_endpoint_hook column. vg-api-server itself no longer reads this.",
      "type": "object",
      "properties": {
        "pathPrefix": {
          "description": "Path appended to the derived host. Must match vg-agentic-endpoint's ingress routePrefix + wsPath.",
          "type": "string",
          "pattern": "^/[^\\s]*$"
        },
        "baseUrl": {
          "description": "Host override for when the adapter isn't on the API host, same syntax as cognigyLogin.baseUrl (an http(s) URL, not a websocket one) — e.g. https://api-dev.cognigy.ai, no path. The scheme is normalized to ws(s):// and pathPrefix is appended automatically. Empty derives the host from cognigyLogin.baseUrl.",
          "type": "string",
          "pattern": "^$|^https?://[^\\s/]+/?$"
        }
      }
    },
    "nice": {
      "type": "object",
      "properties": {
        "sipHeaderCognigyContactData": {
          "type": "string",
          "pattern": "^$|^[A-Za-z][A-Za-z0-9-]*$"
        }
      }
    },
    "vgTestHarness": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "speechInterception": {
          "type": "string",
          "enum": ["none", "vendor"],
          "description": "Whether the harness intercepts real speech-vendor traffic. 'none' (default) redirects nothing at the infrastructure level -- a custom:<name> credential still reaches mock-speech by the URL stored on the credential, needing nothing from this chart. 'vendor' makes VG dial the real vendor hostnames and rewrites them, in-namespace, to mock-speech's TLS listener -- deriving regionDns and its rewrite list, mockSpeech.tls and its certificate, the FreeSWITCH and api-server dnsConfig, and the CA-trust overlay."
        },
        "mockCognigy": {
          "type": "object",
          "properties": {
            "image": { "type": "string" },
            "logLevel": { "type": "string" },
            "resources": { "type": "object" }
          }
        },
        "mockSpeech": {
          "type": "object",
          "properties": {
            "image": { "type": "string" },
            "defaultTranscript": { "type": "string" },
            "resources": { "type": "object" },
            "tls": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "secretName": { "type": "string" },
                "generate": {
                  "type": "boolean",
                  "description": "Whether the chart mints mock-speech's CA and leaf itself (default true), reusing the existing Secret on upgrade so the CA is stable. Applies on the vendor route only: speechInterception=vendor derives the hostname list the leaf must cover. With mockSpeech.tls.enabled alone the Secret must be supplied from outside. Set false where a run mints its own and needs the CA outside the cluster."
                },
                "caConfigMapName": {
                  "type": "string",
                  "description": "ConfigMap holding the CA that signed mock-speech's leaf, mounted by the CA-trust overlay the chart renders on the vendor route. The chart creates it alongside the Secret when generate is true; with generate false it must exist before install."
                },
                "speechVendor": {
                  "type": "string",
                  "enum": ["deepgram", "elevenlabs", "speechmatics", "deepgramflux", "google", "microsoft", "aws"],
                  "description": "Which vendor the provision Job points every provisioned application at. Every vendor is served simultaneously; this only selects what gets provisioned."
                }
              }
            }
          }
        },
        "mockDeepgramRegion": {
          "type": "object",
          "description": "DEPRECATED: superseded by the speech adapter (regionDns.rewrites -> mock-speech plus mockSpeech.tls). Kept so a namespace with its own rewrites still validates; the image pin is frozen because vg-test-harness deleted the binary.",
          "properties": {
            "image": { "type": "string" },
            "replicaCount": { "type": "integer", "minimum": 0 },
            "resources": { "type": "object" }
          }
        },
        "regionDns": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "rewrites": {
              "type": "array",
              "description": "Hostnames test-dns answers for, and the in-namespace Service each resolves to. Point these at mock-speech for the speech adapter.",
              "items": {
                "type": "object",
                "required": ["name", "target"],
                "properties": {
                  "name": { "type": "string" },
                  "target": { "type": "string" },
                  "type": { "type": "string", "enum": ["exact", "regex"] }
                }
              }
            },
            "image": { "type": "string" },
            "clusterIP": { "type": "string" },
            "clusterIPBase": {
              "type": "string",
              "description": "Dotted prefix, e.g. \"172.20.0\", that test-dns's ClusterIP is derived from when clusterIP is unset -- the last octet comes from the namespace name. Normally left empty: the chart defaults the prefix to kube-system/kube-dns's own /24, which Kubernetes reserves for pinned addresses and never allocates from dynamically. Set it only to override that choice."
            },
            "upstream": { "type": "string" },
            "resources": { "type": "object" }
          }
        },
        "sipCaller": {
          "type": "object",
          "properties": {
            "image": { "type": "string" },
            "resources": { "type": "object" }
          }
        },
        "minio": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "image": { "type": "string" },
            "resources": { "type": "object" }
          }
        },
        "autoProvision": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "adminUser": { "type": "string" },
            "adminPass": { "type": "string" },
            "adminPassSecretRef": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "key": { "type": "string" }
              }
            },
            "deepgramApiKey": { "type": "string" },
            "phoneNumber": { "type": "string" },
            "carrierSourceIPv4": { "type": "string" },
            "carrierSourceNetmask": { "type": "integer" },
            "mipTest": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" }
              }
            },
            "recording": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "endpoint": { "type": "string" },
                "bucket": { "type": "string" },
                "accessKey": { "type": "string" },
                "secretKey": { "type": "string" },
                "format": { "type": "string", "enum": ["wav", "mp3"] }
              }
            }
          }
        },
        "deepgramBridge": { "type": "object" }
      }
    },
    "freeswitch": {
      "type": "object",
      "properties": {
        "regionDnsEnabled": { "type": "boolean" }
      }
    },
    "sileroVad": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string" },
        "imagePullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "logLevel": { "type": "string", "enum": ["trace", "debug", "info", "warn", "error", "TRACE", "DEBUG", "INFO", "WARN", "ERROR"] },
        "allowedOrigins": { "type": "string" },
        "drainTimeoutSeconds": { "type": "integer", "minimum": 0 },
        "shutdownTimeoutSeconds": { "type": "integer", "minimum": 0 },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
        "maxConcurrentSessions": { "type": "integer", "minimum": 0 },
        "modelVersionFile": { "type": "string" },
        "shadowModeEnabled": { "type": "boolean" },
        "shadowSampleRate": { "type": ["string", "number"] },
        "prodGraduationEnv": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "extraEnvVars": { "type": "array" },
        "affinity": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "priorityClassName": { "type": "string" },
        "podSecurityContext": { "type": "object" },
        "tolerations": { "type": "array" },
        "resources": { "type": "object" },
        "probes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "startup": { "type": "object" },
            "liveness": { "type": "object" },
            "readiness": { "type": "object" }
          }
        },
        "pdb": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "minAvailable": { "type": ["integer", "string"] },
            "maxUnavailable": { "type": ["integer", "string"] }
          },
          "allOf": [
            {
              "oneOf": [
                { "required": ["minAvailable"], "not": { "required": ["maxUnavailable"] } },
                { "required": ["maxUnavailable"], "not": { "required": ["minAvailable"] } },
                { "not": { "anyOf": [ { "required": ["minAvailable"] }, { "required": ["maxUnavailable"] } ] } }
              ]
            },
            {
              "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
              "then": {
                "oneOf": [
                  { "required": ["minAvailable"] },
                  { "required": ["maxUnavailable"] }
                ]
              }
            }
          ]
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "ingressFrom": { "type": "array" },
            "allowMonitoringScrape": { "type": "boolean" },
            "monitoringNamespaceSelector": { "type": "object" }
          }
        },
        "podMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "path": { "type": "string" },
            "interval": { "type": "string" },
            "scrapeTimeout": { "type": "string" }
          }
        },
        "mysql": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "host": { "type": "string" },
            "database": { "type": "string" },
            "user": { "type": "string" },
            "secretName": { "type": "string" },
            "secretKey": { "type": "string" }
          }
        }
      }
    },
    "otelCollector": {
      "type": "object",
      "properties": {
        "extraOtlpExporters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "endpoint"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$",
                "not": { "const": "jaeger" }
              },
              "endpoint": { "type": "string", "minLength": 1 },
              "insecure": { "type": "boolean" },
              "config": { "type": "object" }
            }
          }
        }
      }
    },
    "featureServer": {
      "type": "object",
      "properties": {}
    }
  }
}